{
  // 默认配置文档的结构版本。
  // 新增配置键或调整结构时递增；启动初始化只补充数据库中缺失的键，
  // 不会覆盖管理员已经保存的配置。
  "schema_version": 1,

  // 可初始化的系统设置集合。
  // 这里只能填写后端类型化 Schema 已支持的分组和字段。
  "settings": {
    // 作品资产相关设置。
    "assets": {
      // 用户删除作品时，如何处理对象存储中的文件。
      // retain_cloud_file：业务记录软删除并隐藏作品，但保留云端文件。
      // delete_cloud_file：业务记录软删除后，排队清理对应云端文件。
      "deletion_policy": "retain_cloud_file"
    }
  }
}
